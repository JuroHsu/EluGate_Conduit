{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EluGate Conduit",
  "version": "0.2.1",
  "identifier": "tw.com.elu.conduit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "EluGate Conduit",
        "url": "index.html?view=main",
        "width": 1080,
        "height": 700,
        "minWidth": 860,
        "minHeight": 560,
        "center": true,
        "visible": false
      },
      {
        "label": "panel",
        "create": false,
        "title": "EluGate Conduit",
        "url": "index.html?view=panel",
        "width": 340,
        "height": 460,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "伊露科技有限公司 Elu Technology Ltd.",
    "targets": [
      "nsis",
      "msi",
      "app",
      "dmg",
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "category": "DeveloperTool",
    "shortDescription": "SSH 通道管理器",
    "linux": {
      "deb": { "depends": ["openssh-client"] },
      "rpm": { "depends": ["openssh-clients"] }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "wix": {
        "language": {
          "zh-TW": {
            "localePath": "installer/zh-TW.wxl"
          }
        },
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      },
      "nsis": {
        "languages": [
          "English",
          "TradChinese",
          "SimpChinese",
          "Japanese",
          "Korean",
          "Spanish",
          "French",
          "German",
          "PortugueseBR",
          "Russian"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp"
      }
    }
  }
}
